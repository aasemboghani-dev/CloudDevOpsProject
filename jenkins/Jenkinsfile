pipeline {
    agent any

    environment {
        AWS_REGION = 'ap-south-1'
        ECR_REPO = '090597375004.dkr.ecr.ap-south-1.amazonaws.com/cloud-devops-app'
        EKS_CLUSTER = 'cloud-devops-cluster'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/aasemboghani-dev/CloudDevOpsProject.git'
            }
        }

        stage('Docker Build') {
            steps {
                dir('application') {
                    sh 'docker build -t cloud-devops-app:latest .'
                }
            }
        }

        stage('Docker Test') {
            steps {
                sh 'docker images cloud-devops-app'
            }
        }

        stage('ECR Login') {
            steps {
                sh 'aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $ECR_REPO'
            }
        }

        stage('Docker Push') {
            steps {
                sh '''
                    docker tag cloud-devops-app:latest $ECR_REPO:latest
                    docker push $ECR_REPO:latest
                '''
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh '''
                    aws eks update-kubeconfig --region $AWS_REGION --name $EKS_CLUSTER
                    kubectl rollout restart deployment/cloud-devops-app
                    kubectl rollout status deployment/cloud-devops-app
                '''
            }
        }
    }
}